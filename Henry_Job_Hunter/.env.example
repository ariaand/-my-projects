# Copy this file to .env and fill in your values
# Never commit .env to git

# Required: Anthropic API key for resume tailoring and cover letters
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: SerpAPI key for enhanced Google Jobs searching
# Free tier available at https://serpapi.com
SERPAPI_KEY=

# Optional: If you want to export tracker to Google Sheets,
# add your Google service account credentials path here
GOOGLE_CREDENTIALS_PATH=
GOOGLE_SHEET_ID=
